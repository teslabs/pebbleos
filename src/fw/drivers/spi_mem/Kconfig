if SOC_NRF52

config NRF5_QSPI_CLK_FREQ_HZ
    int "nRF5 QSPI clock frequency (Hz)"
    default 8000000
    help
      Frequencies above 8 MHz are exposed to nRF52 anomaly 244.

config NRF5_QSPI_SCK_PIN
    int "nRF5 QSPI SCK pin"
    default 0

config NRF5_QSPI_CSN_PIN
    int "nRF5 QSPI CSN pin"
    default 0

config NRF5_QSPI_IO0_PIN
    int "nRF5 QSPI IO0 pin"
    default 0

config NRF5_QSPI_IO1_PIN
    int "nRF5 QSPI IO1 pin"
    default 0

config NRF5_QSPI_IO2_PIN
    int "nRF5 QSPI IO2 pin"
    default 0

config NRF5_QSPI_IO3_PIN
    int "nRF5 QSPI IO3 pin"
    default 0

endif # SOC_NRF52

if SOC_SF32LB52

config SF32LB52_MPI_INSTANCE
    int "SF32LB52 MPI controller instance"
    range 1 2
    default 2

config SF32LB52_MPI_MSIZE
    int "SF32LB52 MPI memory window size (MB)"
    default 32

config SF32LB52_MPI_CLK_DIV
    int "SF32LB52 MPI clock divider"
    default 0

config SF32LB52_MPI_DMA_CHANNEL
    int "SF32LB52 MPI DMAC1 channel"
    range 1 8
    default 2

config SF32LB52_MPI_DMA_REQUEST
    int "SF32LB52 MPI DMA request"
    default 1

config SF32LB52_MPI_INVERT_RX_CLK
    bool "SF32LB52 MPI: invert the receive clock"

endif # SOC_SF32LB52

menuconfig SPI_MEM
    bool "SPI memory bus"
    help
      Controllers that execute command/address/dummy/data transactions
      against SPI memories (NOR, NAND, PSRAM).

if SPI_MEM

config SPI_MEM_NRF5_QSPI
    bool "nRF5 QSPI"
    depends on SOC_NRF52
    default y
    help
      The nRF5 QSPI peripheral as a spi_mem controller. Pins and clock
      come from NRF5_QSPI_*.

config SPI_MEM_SF32LB52_MPI
    bool "SF32LB52 MPI"
    depends on SOC_SF32LB52
    default y
    help
      An SF32LB52 MPI controller in QSPI NOR mode as a spi_mem controller,
      driven at register level from RAM. Instance, clock and DMA come from
      SF32LB52_MPI_*.

endif # SPI_MEM
