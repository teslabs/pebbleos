menuconfig FLASH
    bool "Flash"
    help
      Flash Drivers

if FLASH

config FLASH_SEC_REGS
    bool
    help
      Selected by drivers that provide the security register functions,
      pbl_flash_sec_reg_*().

config FLASH_GD25LQ255E
    bool "GigaDevice GD25LQ255E"
    help
      Support for the GigaDevice GD25LQ255E NOR flash.

config FLASH_GD25Q256E
    bool "GigaDevice GD25Q256E"
    help
      Support for the GigaDevice GD25Q256E NOR flash.

config FLASH_NRF5_QSPI
    bool "Nordic nRF5 QSPI"
    default y if SOC_NRF52
    depends on SOC_NRF52
    select FLASH_SEC_REGS
    help
      Support for a NOR flash on the Nordic nRF5 QSPI peripheral.

config FLASH_SPI_NOR
    bool "SPI NOR"
    depends on SPI_MEM
    select FLASH_SEC_REGS
    help
      Support for a JEDEC NOR flash on a SPI memory controller, described
      by its SFDP tables and the board's part description.

config FLASH_SF32LB52_MPI
    bool "SiFli SF32LB52 MPI"
    default y if SOC_SF32LB52
    depends on SOC_SF32LB52
    select FLASH_SEC_REGS
    help
      Support for a NOR flash on a SiFli SF32LB52 MPI controller.

config FLASH_QEMU
    bool "QEMU External Flash"
    default y if SOC_QEMU
    help
      Support for the QEMU external flash peripheral.

config FLASH_POSIX
    bool "POSIX External Flash"
    default y if SOC_POSIX
    help
      External flash backed by a file on the host.

config FLASH_SHELL
    bool "Shell commands"
    default y
    depends on SHELL
    help
      The flash shell command, to inspect, erase and test the flash.

module = DRIVER_FLASH
module-str = Flash
source "subsys/logging/Kconfig.template.log_level"

endif # FLASH
