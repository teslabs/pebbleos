menu "Bluetooth"

config BT
    bool
    default y
    select MBEDTLS
    help
      The Bluetooth subsystem: the NimBLE host and the PebbleOS glue
      around it.

if BT

choice BT_HCI
    prompt "HCI transport"
    default BT_HCI_FAKE
    help
      How the NimBLE host reaches its controller. The default is derived
      from the SoC (see each soc/<soc>/Kconfig.defconfig); the fake
      controller is the fallback where there is no radio.

config BT_HCI_NRF52
    bool "NimBLE controller on the nRF52 radio"
    depends on SOC_NRF52
    help
      Run the NimBLE link layer in the same image, on the nRF52 radio.

config BT_HCI_SF32LB52
    bool "SiFli LCPU over IPC"
    depends on SOC_SF32LB52
    select HAL_SIFLI_IPC_QUEUE
    select HAL_SIFLI_LCPU
    help
      Talk H4 HCI to the SiFli controller running on the LCPU through the
      mailbox IPC queue.

config BT_HCI_FAKE
    bool "Fake controller"
    help
      Answer every HCI command locally with success and never raise an
      event. The host synchronises and the GATT server runs, but no link
      can be established. For targets without a radio, such as QEMU.

endchoice

module = BT
module-str = Bluetooth
source "subsys/logging/Kconfig.template.log_level"

config BT_GH3X2X_TUNING_SERVICE
    bool "GH3X2X tuning service"
    depends on HRM_GH3X2X
    help
      Build the GH3X2X heart-rate sensor tuning GATT service, used to
      tune the sensor over BLE. Off by default.

config BT_CLASSIC
    bool "Classic HFP calling alongside NimBLE (experimental)"
    depends on BT_HCI_SF32LB52 && MIC_POLLING && SPEAKER_PLAYBACK_OBSERVER && SERVICE_SPEAKER
    select NIMBLE_BLE_CLASSIC
    select BT_HFP
    select BT_HCI_AUDIO_ADAPTER
    select BT_HCI_LOCAL_AUDIO
    select BT_HCI_SOFTWARE_CVSD
    help
      Run the project-owned Classic profiles next to the NimBLE BLE
      services. NimBLE owns controller startup, HCI commands and ACL
      credits. Supports one phone and CVSD audio. Pair over BLE using
      Secure Connections; CTKD shares the persistent bond with Classic.

config BT_HFP
    bool
    help
      The project-owned Classic host with the Hands-Free profile, driven
      over HCI by whichever transport can carry BR/EDR traffic.

config BT_HCI_AUDIO_PROBE
    bool "SiFli shared audio mailbox diagnostic"
    depends on BT_HFP && BT_HCI_SF32LB52 && PROMPT
    default y
    help
      Initialize the controller's shared audio rings and count mailbox 6
      notifications. The 'bt audio probe' command reports ring metadata;
      without the adapter option, no audio payload is read or transmitted.

config BT_HCI_AUDIO_ADAPTER
    bool "SiFli native audio to HCI SCO adapter"
    depends on BT_HFP && BT_HCI_SF32LB52
    help
      Translate the shared audio rings to standard HCI SCO packets for
      one CVSD link with signed 16-bit PCM. Requires legacy synchronous
      connection setup. The adapter stays below the portable host's HCI
      boundary.

config BT_HCI_LOCAL_AUDIO
    bool "Local HFP microphone and speaker"
    depends on BT_HCI_AUDIO_ADAPTER && MIC_POLLING && SPEAKER_PLAYBACK_OBSERVER && SERVICE_SPEAKER
    select SPEAKER_SF32LB_DIAGNOSTICS if SPEAKER_SF32LB
    help
      Route HCI SCO PCM through the watch audio services. Experimental
      echo cancellation can be enabled for a debug call with
      'bt audio echo 1'. It requires timed capture and playback driver
      hooks and remains disabled by default pending acoustic
      qualification.

config BT_HCI_SOFTWARE_CVSD
    bool "Software CVSD codec"
    depends on BT_HCI_AUDIO_ADAPTER
    help
      Use raw CVSD in the SiFli audio mailbox and translate it to the same
      signed 16-bit HCI PCM interface with the project's codec, bypassing
      the controller's hardware PCM conversion.

config BT_CONTROLLER_PROBE
    bool "Controller capability probe command"
    depends on PROMPT
    select NIMBLE_BLE_HS_LOCAL_INFO
    help
      Add the 'bt controller probe' console command, which reports the
      controller version, supported commands, LMP features and buffer
      sizes that the NimBLE host read while synchronising, without
      sending HCI commands of its own.

endif

endmenu
